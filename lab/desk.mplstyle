# Desk figure style: the SciencePlots "science" + "grid" + "no-latex" styles, then the house settings of Lucas's
# research papers (palette, light horizontal grid, no legend frame). Vendored here so nothing extra is installed.
# Load with: plt.style.use(ROOT / "lab" / "desk.mplstyle")
axes.prop_cycle : cycler('color', ['1D4A78', '96282B', '2C6E54', '8A6D3B', '4A7BA6', '6B4E79', '8C8C8C'])
figure.figsize : 7, 2.3333
font.size : 11
axes.titlesize : 12
axes.labelsize : 11
xtick.labelsize : 10
ytick.labelsize : 10
legend.fontsize : 10
xtick.direction : in
xtick.major.size : 3
xtick.major.width : 0.5
xtick.minor.size : 1.5
xtick.minor.width : 0.5
xtick.minor.visible : True
xtick.top : True
ytick.direction : in
ytick.major.size : 3
ytick.major.width : 0.5
ytick.minor.size : 1.5
ytick.minor.width : 0.5
ytick.minor.visible : True
ytick.right : True
axes.linewidth : 0.5
axes.axisbelow : True
axes.grid : True
axes.grid.axis : y
grid.linestyle : --
grid.color : 9aa0a6
grid.alpha : 0.18
grid.linewidth : 0.4
lines.linewidth : 1.3
legend.frameon : False
legend.numpoints : 1
text.usetex : False
font.family : serif
font.serif : STIXGeneral, DejaVu Serif
axes.formatter.use_mathtext : True
mathtext.fontset : cm
figure.dpi : 120
savefig.dpi : 300
savefig.bbox : tight
savefig.pad_inches : 0.05
